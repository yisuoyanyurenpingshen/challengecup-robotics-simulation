<?xml version="1.0"?>
<sdf version="1.8">
  <world name="smartclean_empty">
    <gravity>0 0 -9.8</gravity>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.42 0.42 0.42 1</ambient>
      <background>0.65 0.78 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.75 0.75 0.72 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.45 0.25 -0.86</direction>
    </light>
    <light name="camera_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0.45 0 2.0 0 0 0</pose>
      <diffuse>0.30 0.30 0.30 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.60 0.05 -0.60</direction>
    </light>

    <model name="drive_surface">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 16</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 16</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.32 0.36 0.34 1</ambient>
            <diffuse>0.42 0.47 0.44 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_planter">
      <static>true</static>
      <pose>4 3 0.40 0 0 0</pose>
      <link name="planter_link">
        <collision name="planter_collision">
          <geometry>
            <cylinder>
              <radius>0.8</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="planter_visual">
          <geometry>
            <cylinder>
              <radius>0.8</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.18 0.38 0.18 1</ambient>
            <diffuse>0.24 0.52 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="waste_bin">
      <static>true</static>
      <pose>-4 -3 0.50 0 0 0</pose>
      <link name="bin_link">
        <collision name="bin_collision">
          <geometry>
            <box>
              <size>0.75 0.75 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="bin_visual">
          <geometry>
            <box>
              <size>0.75 0.75 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.28 0.38 1</ambient>
            <diffuse>0.14 0.43 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Local trash scene: same robot, plus five synthetic litter models. -->

    <include>
      <uri>model://smartclean_robot</uri>
      <name>smartclean_robot</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
