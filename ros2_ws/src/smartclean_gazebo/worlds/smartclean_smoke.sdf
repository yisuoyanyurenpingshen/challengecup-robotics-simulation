            <ambient>0.18 0.36 0.46 1</ambient>
            <diffuse>0.22 0.52 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pedestrian_island">
      <static>true</static>
      <pose>1 1 0.30 0 0 0.22</pose>
      <link name="island_link">
        <collision name="island_collision">
