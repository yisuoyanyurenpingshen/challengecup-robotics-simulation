          <material>
            <ambient>0.45 0.48 0.52 1</ambient>
            <diffuse>0.58 0.62 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="waste_station">
      <static>true</static>
      <pose>16 -11 1.5 0 0 0</pose>
      <link name="station_link">
