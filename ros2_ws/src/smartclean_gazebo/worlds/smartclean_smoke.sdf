<?xml version="1.0"?>
<sdf version="1.8">
  <world name="smartclean_smoke">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.64e-6 2.29e-5 -4.24e-5</magnetic_field>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.65 0.78 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <model name="smartclean_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.30 0.34 0.32 1</ambient>
            <diffuse>0.36 0.42 0.38 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="service_building">
      <static>true</static>
      <pose>-15 10 2.5 0 0 0</pose>
      <link name="building_link">
        <collision name="building_collision">
          <geometry><box><size>10 7 5</size></box></geometry>
        </collision>
