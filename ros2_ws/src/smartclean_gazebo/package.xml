<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smartclean_gazebo</name>
  <version>0.1.0</version>
  <description>Local, headless Gazebo Fortress smoke world for SmartClean-Sim.</description>
  <maintainer email="smartclean@example.com">SmartClean Team</maintainer>
  <license>Proprietary</license>
  <url type="repository">https://github.com/yisuoyanyurenpingshen/challengecup-robotics-simulation</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
