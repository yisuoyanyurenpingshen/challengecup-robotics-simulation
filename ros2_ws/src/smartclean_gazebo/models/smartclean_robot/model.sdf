<?xml version="1.0"?>
<sdf version="1.8">
  <model name="smartclean_robot">
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- Ground-level origin frame: DiffDrive publishes odom -> base_footprint,
         robot_state_publisher owns base_footprint -> base_link. -->
    <link name="base_footprint">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <collision name="footprint_collision">
        <geometry>
          <box>
            <size>0.02 0.02 0.01</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
      <pose>0 0 0.25 0 0 0</pose>
    </joint>

    <!-- The base link represents the main cleaning-vehicle body. -->
    <link name="base_link">
      <pose>0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>45.0</mass>
        <inertia>
          <ixx>1.779</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>3.047</iyy>
          <iyz>0.0</iyz>
          <izz>4.151</izz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.90 0.62 0.30</size>
          </box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.90 0.62 0.30</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.32 0.52 1</ambient>
          <diffuse>0.05 0.48 0.72 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
      <visual name="top_cover_visual">
        <pose>-0.08 0 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.56 0.48 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.72 0.78 0.80 1</ambient>
          <diffuse>0.86 0.91 0.92 1</diffuse>
        </material>
      </visual>
      <visual name="status_beacon_visual">
        <pose>-0.16 0 0.31 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.62 0.25 1</ambient>
          <diffuse>0.10 0.90 0.35 1</diffuse>
          <emissive>0.02 0.22 0.08 1</emissive>
        </material>
      </visual>
      <visual name="left_brush_visual">
        <pose>0.35 0.35 -0.19 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.13</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="right_brush_visual">
        <pose>0.35 -0.35 -0.19 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.13</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel_link">
      <pose>0.12 0.37 0.14 0 0 0</pose>
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.01358</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.02450</iyy>
          <iyz>0.0</iyz>
          <izz>0.01358</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.14</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>0.7</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="left_wheel_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.14</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.035 0.035 0.035 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel_link">
      <pose>0.12 -0.37 0.14 0 0 0</pose>
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.01358</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.02450</iyy>
          <iyz>0.0</iyz>
          <izz>0.01358</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.14</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>0.7</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="right_wheel_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.14</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.035 0.035 0.035 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="caster_link">
      <pose>-0.34 0 0.075 0 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.001575</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.001575</iyy>
          <iyz>0.0</iyz>
          <izz>0.001575</izz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry>
          <sphere>
            <radius>0.075</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.3</mu>
              <mu2>0.3</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="caster_visual">
        <geometry>
          <sphere>
            <radius>0.075</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.14 0.14 0.14 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="camera_link">
      <pose>0.45 0 0.45 0 -0.15 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0002</iyy>
          <iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.08 0.06 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.08 0.06 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.18 0.18 0.22 1</diffuse>
        </material>
      </visual>
      <sensor name="rgbd_camera" type="rgbd_camera">
        <pose>0 0 0 0 0 0</pose>
        <topic>/smartclean/camera</topic>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.0471975512</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <depth_camera>
            <clip>
              <near>0.05</near>
              <far>20</far>
            </clip>
          </depth_camera>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>0</visualize>
      </sensor>

    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
          <effort>80.0</effort>
          <velocity>12.0</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.02</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
          <effort>80.0</effort>
          <velocity>12.0</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.02</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
    <link name="lidar_link">
      <pose>0.05 0 0.47 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.10 0.10 1</ambient>
          <diffuse>0.55 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/smartclean/lidar/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>12</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>0</visualize>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>


    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.74</wheel_separation>
      <wheel_radius>0.14</wheel_radius>
      <topic>/smartclean/safe_cmd_vel</topic>
      <odom_topic>/smartclean/odom</odom_topic>
      <tf_topic>/smartclean/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>1.2</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>
  </model>
</sdf>
