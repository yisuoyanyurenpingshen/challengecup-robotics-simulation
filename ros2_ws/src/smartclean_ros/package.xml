<?xml version="1.0"?>
<package format="3">
  <name>smartclean_ros</name>
  <version>0.1.0</version>
  <description>SmartClean-Sim 的 ROS 2 薄适配、轨迹回放与速度安全看门狗节点。</description>
  <maintainer email="smartclean@example.com">SmartClean Team</maintainer>
  <license>Proprietary</license>
  <url type="repository">https://github.com/yisuoyanyurenpingshen/challengecup-robotics-simulation</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>smartclean_core</exec_depend>
  <exec_depend>smartclean_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
