# Python 缓存
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# 虚拟环境 / Conda 环境
.env
.venv/
.pixi/
.tools/
.cache/
.ros/
.gazebo/
venv/
env/
envs/*
!envs/README.md
!envs/*.md
!envs/*.txt
!envs/*.yml
!envs/*.yaml
conda_env/

# 数据集：只保留 README，不上传大数据
data/
datasets/*
!datasets/README.md
!datasets/*.md

# 模型权重：只保留 README，不上传大权重
weights/*
!weights/README.md
!weights/*.md
!weights/model-card-template.json

# 训练输出 / 临时文件
runs/
tmp/

# 结果文件：默认只保留轻量说明和小型图片/表格
results/*
!results/README.md
!results/*.md
!results/*.txt
!results/*.csv
!results/*.png
!results/*.jpg
!results/*.jpeg
!results/*.json
!results/*.html

# ROS2 / colcon 构建产物（不要忽略公共 logs/）
install/
log/
ros2_ws/.colcon/

# 模型文件
*.pt
*.pth
*.onnx
*.engine

# 压缩包和视频
*.zip
*.tar
*.tar.gz
*.mp4
*.avi
*.mkv

# 密钥和敏感信息
